# server configuration
NODE_ENV=development
PORT=5000
API_HOST=http://localhost:5000/
DEBUG=false

# session secret
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./config/public.pem

# file upload path
UPLOAD_PATH=./uploads

# database connection
DB_HOST=localhost
DB_USER=starterkit
DB_PASSWORD=starterkit
DB_NAME=starterkit
# DB_HOST_REPLICA=

# GCP configuration
STORAGE_TYPE=local
GOOGLE_MAP_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=./secrets/gcp-service-account.json
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_API_URI=

# AWS configuration (Terraform in terraform/aws-rdigital reads these + EC2_KEY_NAME)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
# Same EC2 SSH key pair name for both API and admin instances (must exist in AWS)
EC2_KEY_NAME=
AWS_BUCKET=
AWS_S3_API_URI=

# Mail configuration
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM_NAME=Starter Kit
MAIL_FROM=

# Cache configuration
REDIS_URL=
UPSTASH_REDIS_URL=

# Shared secret for internal server-to-server auth bypass
INTERNAL_SECRET=replace-with-a-long-random-string

# Competitor Analyzer SERP provider
# Supported values: serper, serpapi
SERP_PROVIDER=serper
SERPER_API_URL=https://google.serper.dev/search
SERPER_API_KEY=
SERPAPI_API_URL=https://serpapi.com/search.json
SERPAPI_API_KEY=
HTTP_CLIENT_TIMEOUT_MS=15000

# Sitemap automation web indexing (server-side secret)
# If users enable indexing in UI, backend submits URLs using IndexNow format.
WEB_INDEX_KEY=
WEB_INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
WEB_INDEX_TIMEOUT_MS=12000
WEB_INDEX_MAX_URLS_PER_RUN=1000
