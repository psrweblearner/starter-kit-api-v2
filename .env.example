# server configuration
NODE_ENV=development
PORT=5000
API_HOST=http://localhost:5000/
DEBUG=false

# session secret
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./config/public.pem

# file upload path
UPLOAD_PATH=./uploads

# database connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=api_starter_kit_db
# DB_HOST_REPLICA=

# GCP configuration
STORAGE_TYPE=local
GOOGLE_MAP_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=./secrets/gcp-service-account.json
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_API_URI=

# AWS configuration
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_S3_API_URI=

# Cache configuration
REDIS_URL=
UPSTASH_REDIS_URL=

# Shared secret for internal server-to-server auth bypass
INTERNAL_SECRET=replace-with-a-long-random-string
