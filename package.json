{
  "name": "starter-kit",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:sanitize-dump": "node scripts/sanitize-mysql-dump.js",
    "db:migrate": "npx sequelize-cli db:migrate --env production",
    "db:seed": "npx sequelize-cli db:seed:all --env production",
    "tf:aws:init": "terraform -chdir=deploy/aws init",
    "tf:aws:plan": "terraform -chdir=deploy/aws plan -var-file=terraform.tfvars",
    "tf:aws:apply": "terraform -chdir=deploy/aws apply -var-file=terraform.tfvars -auto-approve",
    "tf:aws:destroy": "terraform -chdir=deploy/aws destroy -var-file=terraform.tfvars -auto-approve",
    "deploy:aws": "npm run tf:aws:init && npm run tf:aws:apply",
    "destroy:aws": "npm run tf:aws:init && npm run tf:aws:destroy",
    "tf:gcp:init": "terraform -chdir=deploy/gcp init",
    "tf:gcp:plan": "terraform -chdir=deploy/gcp plan -var-file=terraform.tfvars",
    "tf:gcp:apply": "terraform -chdir=deploy/gcp apply -var-file=terraform.tfvars -auto-approve",
    "tf:gcp:destroy": "terraform -chdir=deploy/gcp destroy -var-file=terraform.tfvars -auto-approve",
    "deploy:gcp": "npm run tf:gcp:init && npm run tf:gcp:apply",
    "destroy:gcp": "npm run tf:gcp:init && npm run tf:gcp:destroy",
    "tf:linode:init": "terraform -chdir=deploy/linode init",
    "tf:linode:plan": "terraform -chdir=deploy/linode plan -var-file=terraform.tfvars",
    "tf:linode:apply": "terraform -chdir=deploy/linode apply -var-file=terraform.tfvars -auto-approve",
    "tf:linode:destroy": "terraform -chdir=deploy/linode destroy -var-file=terraform.tfvars -auto-approve",
    "deploy:linode": "npm run tf:linode:init && npm run tf:linode:apply",
    "destroy:linode": "npm run tf:linode:init && npm run tf:linode:destroy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@upstash/redis": "^1.36.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.75.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  }
}
